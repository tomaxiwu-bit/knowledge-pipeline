# Ollama runs locally. On macOS/Windows Docker resolves host.docker.internal.
# On Linux, change this to your bridge gateway or run the API directly on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:4b

# "lexical" works with no additional model. "cross_encoder" enables the
# local sentence-transformers reranker after its model is available.
RERANKER_MODE=lexical
RERANKER_MODEL=BAAI/bge-reranker-base
